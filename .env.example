# App e jobs (Transaction pooler, porta 6543)
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Só migrations (Session pooler, porta 5432)
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres"
# Protege POST /api/revalidate
REVALIDATE_SECRET=""
# CSV anual de despesas da Câmara; {ano} é substituído (ex.: 2026)
CAMARA_DESPESAS_CSV_URL="https://www.camara.leg.br/cotas/Ano-{ano}.csv.zip"
# Despesas dos senadores (CEAPS), API administrativa em JSON; {ano} é substituído (ex.: 2026)
SENADO_CEAPS_URL="https://adm.senado.gov.br/adm-dadosabertos/api/v1/senadores/despesas_ceaps/{ano}"
# Relatório mensal "Análise da Arrecadação" (PDF) da Receita Federal; {ano} e {mes} (jan, fev, ..., dez) são substituídos
RECEITA_ANALISE_URL="https://www.gov.br/receitafederal/pt-br/centrais-de-conteudo/publicacoes/relatorios/arrecadacao-federal/{ano}/analise-mensal-{mes}-{ano}.pdf"

# Página "Apoie o projeto": código "Pix copia e cola" ESTÁTICO (sem valor) gerado pelo seu banco, com chave aleatória.
# Sem ele, a página e o link no menu não existem. Se o código for inválido (CRC, QR de uso único...), o build falha.
PIX_COPIA_E_COLA=""
# Nome mostrado no texto da página (se vazio, usa o nome que vem no código Pix)
APOIE_AUTOR=""
