{
  "name": "olho-na-republica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:deputados": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-deputados.ts",
    "sync:despesas": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-despesas.ts",
    "sync:votacoes": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-votacoes.ts",
    "sync:medidas-provisorias": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-medidas-provisorias.ts",
    "sync:proposicoes": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-proposicoes.ts",
    "sync:senadores": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-senadores.ts",
    "sync:ceaps": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-ceaps.ts",
    "sync:votacoes-senado": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-votacoes-senado.ts",
    "sync:proposicoes-senado": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-proposicoes-senado.ts",
    "sync:eleicoes": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-eleicoes.ts",
    "sync:arrecadacao": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-arrecadacao.ts",
    "sync:arrecadacao-estados": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-arrecadacao-estados.ts",
    "sync:presidentes": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-presidentes.ts",
    "sync:orcamento": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-orcamento.ts",
    "sync:arrecadacao-detalhe": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-arrecadacao-detalhe.ts",
    "sync:receita-estadual": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/sync-receita-estadual.ts",
    "job:tamanho-banco": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/tamanho-banco.ts",
    "job:revalidar": "tsx --env-file=.env --tsconfig tsconfig.json src/jobs/revalidar.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.105.0",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
